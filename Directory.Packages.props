<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- 打包 / 源码链接（common.props 引用） -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
	</ItemGroup>

	<!-- src：编译器层扩展与运行时库 -->
	<ItemGroup>
		<!-- L3：测试辅助包的 AutoFixture 适配。核心包本身零第三方依赖，只有这个适配包引它。 -->
		<PackageVersion Include="AutoFixture" Version="4.18.1" />
		<PackageVersion Include="IndexRange" Version="1.1.1" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
	</ItemGroup>

	<!-- test：测试框架与 Roslyn 测试框架 -->
	<ItemGroup>
		<!-- K1：属性测试（round-trip 不变式）。选 CsCheck 而非 FsCheck：纯 C#、无 F# 运行时依赖，
		     且生成与收缩都基于 PCG，失败时能给出可复现的 seed。 -->
		<!-- Bogus 集成：.NET 测试数据生成的事实标准之一（bUnit 作者维护）。 -->
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="CsCheck" Version="4.9.1" />
		<PackageVersion Include="Dapper" Version="2.1.89" />
		<!--
		     钉在 7.2.0：这是 FluentAssertions 最后一个 MIT 许可版本。8.0 起改由 Xceed 商业授权，
		     免费使用仅限非商业项目，且 8.x 在运行时还会打印授权提示。本仓是 MIT 开源库，测试依赖
		     不能引入需要商业授权的组件，故锁死 7.x 并停止跟随 dependabot 的 major 升级。
		     7.2.0 已覆盖本仓用到的全部断言 API（Should/Throw/NotThrow/ContainSingle/OnlyContain 等）。
		-->
		<PackageVersion Include="FluentAssertions" Version="7.2.2" />
		<!--
		     GraphQL 集成：HotChocolate 13.x 是当前 LTS 线。scalar 契约（ScalarType<T> 的
		     TrySerialize / TryDeserialize / ParseLiteral）在 13 与 14 之间没有变化，但 14 改了
		     AddGraphQLServer 的装配入口，故门控钉在 13。
		-->
		<PackageVersion Include="HotChocolate.AspNetCore" Version="13.9.14" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
		<!--
		     集成运行时测试用真实 SQLite 验证 Dapper 读写往返：驱动返回的 CLR 类型与基元不一致（枚举列 long、
		     char / Guid 列 string、decimal 列 double），只有真库才能覆盖。
		     两者不在同一条补丁线上：Sqlite 走 10.x（Microsoft.Data.Sqlite 10 可在 net8.0 上运行），EF Core 固定在
		     8.0.x。这是 dependabot 单独升级 Sqlite 的结果，集成测试与 SampleIntegrations 均已验证可共存。
		-->
		<PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.32" />
		<!--
		     内存服务器：让 Swagger 回归跑真实的 ASP.NET Core 管道。缺口出在框架与 Swashbuckle 的交界处，
		     模拟宿主测不出来。与其余 ASP.NET Core 包同走 8.0.x 补丁线。
		-->
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.32" />
		<!--
		     二进制序列化集成：MessagePack 与 BSON 的格式化器/序列化器都在「引用了才有」的门控之下，集成测试工程
		     必须真的引用它们。IsBinaryTextPrimitive 让这三种基元走规范文本形，但两边的理由已经不同：
		     BSON 3.x 至今没有 Int128 / UInt128 / BigInteger 的序列化器（写出来是空文档，读回 0，静默丢数据），
		     所以那边仍然必需；MessagePack 3.x 已能原生编码三者，本库继续用文本形只是为了与 2.x 时代的载荷兼容。
		-->
		<PackageVersion Include="MessagePack" Version="3.1.12" />
		<PackageVersion Include="MongoDB.Bson" Version="3.12.0" />
		<!--
		     protobuf-net：surrogate 契约的端到端证据。3.x 把特性拆到 protobuf-net.Core、Serializer 留在
		     protobuf-net，两者由同一个包引入。门控查后者（引用它必然带上前者）。
		-->
		<PackageVersion Include="protobuf-net" Version="3.2.30" />
		<!--
		     ULID：第三方自定义基元的端到端证据。Cysharp 的 Ulid 同时实现 IParsable<Ulid>、IComparable<Ulid>
		     与非泛型 IComparable，正好满足自定义基元契约 —— 本库不需要为它加任何代码。
		-->
		<PackageVersion Include="Ulid" Version="1.3.4" />
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
		<!--
		  不登记 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio：.NET 10 SDK 起 MTP 不再支持 VSTest target，
		  这两个包会把 dotnet test 拽回 VSTest 路径并直接报错。测试工程统一由 xunit.v3 自带的 MTP in-proc runner
		  承载（见 test.props）。
		-->
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

	<!-- bench：基准工程（bench.props 引用） -->
	<ItemGroup>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
	</ItemGroup>

	<!-- samples：示例项目 -->
	<ItemGroup>
		<!-- 与 EF Core 统一在 8.0.32：示例是使用者照抄的对象，不能停在 8.0.0 首发版。
		     （Microsoft.Data.Sqlite 单独走 10.x，见上方 test 分组；两者不同补丁线但已验证可共存。）
		     Sample2 面向 net10.0，通过 VersionOverride 单独抬到 10.x。 -->
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.32" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.32" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.32" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.32" />
		<!--
		     配置绑定演示：SampleConsole 用内存配置源演示 TypeConverter 对 binder 的作用。
		     8.0.0 是 8.0 线的首发版，8.0.x 没有 8.0.32 这个补丁号（EF Core 的补丁号与它不同步）。
		-->
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>
</Project>
