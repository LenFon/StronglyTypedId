<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- 打包 / 源码链接（common.props 引用） -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
	</ItemGroup>

	<!-- src：编译器层扩展与运行时库 -->
	<ItemGroup>
		<!-- L3：测试辅助包的 AutoFixture 适配。核心包本身零第三方依赖，只有这个适配包引它。 -->
		<PackageVersion Include="AutoFixture" Version="4.18.1" />
		<PackageVersion Include="IndexRange" Version="1.1.1" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
	</ItemGroup>

	<!-- test：测试框架与 Roslyn 测试框架 -->
	<ItemGroup>
		<!-- K1：属性测试（round-trip 不变式）。选 CsCheck 而非 FsCheck：纯 C#、无 F# 运行时依赖，
		     且生成与收缩都基于 PCG，失败时能给出可复现的 seed。 -->
		<PackageVersion Include="CsCheck" Version="4.9.1" />
		<PackageVersion Include="Dapper" Version="2.1.35" />
		<PackageVersion Include="FluentAssertions" Version="8.10.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
		<!-- 集成运行时测试用真实 SQLite 验证 Dapper 的读写往返：驱动返回的 CLR 类型与基元不一致
		     （枚举列 long、char / Guid 列 string、decimal 列 double），只有真库才能覆盖这条路径。 -->
		<PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.11" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
		<!--
		  不登记 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio：.NET 10 SDK 起
		  MTP 不再支持 VSTest target，这两个包会把 dotnet test 拽回 VSTest 路径并直接报错。
		  测试工程统一由 xunit.v3 自带的 MTP in-proc runner 承载（见 test.props）。
		-->
		<PackageVersion Include="xunit.v3" Version="4.0.1" />
	</ItemGroup>

	<!-- bench：基准工程（bench.props 引用） -->
	<ItemGroup>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
	</ItemGroup>

	<!-- samples：示例项目 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.32" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.32" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
	</ItemGroup>
</Project>
