<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\common.props" />
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<PackageReadmeFile>TESTING.md</PackageReadmeFile>
		<Description>Bogus integration for Len.StronglyTypedId: teaches Bogus to fill strongly typed ids, so faker.Generate() just works.</Description>
		<PackageTags>len;id;strongly-typed;testing;bogus;faker;fake-data;DDD</PackageTags>
		<!-- 本包在 1.3.0-preview.5 基线里不存在，退出跨版本比对（包内一致性校验保留）。 -->
		<StronglyTypedIdPackageValidationBaseline></StronglyTypedIdPackageValidationBaseline>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bogus" />
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Len.StronglyTypedId.Testing\Len.StronglyTypedId.Testing.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="..\..\PACKAGE.md" />
		<None Include="..\..\TESTING.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>
</Project>
