<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\common.props" />
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!--
		  声明运行时库兼容 Native AOT 与裁剪（trimming）：强类型 Id 的核心类型与生成的转换器在 AOT 下
		  零动态代码生成、零按名加载类型。开启后 MSBuild 会对本程序集自身跑裁剪 / AOT 分析器，
		  本库唯一用到反射的 StronglyTypedIdExtensions（GetInterfaces/GetGenericTypeDefinition）不走
		  RequiresUnreferencedCode 路径，故不产生 IL2026 / IL3050。
		-->
		<IsAotCompatible>true</IsAotCompatible>
		<!--
		  RS0016/RS0017 由 Microsoft.CodeAnalysis.PublicApiAnalyzers 报出，默认是警告。本仓库的基线是
		  「0 警告」，靠默认严重级别等于没有约束（一次 NoWarn 或一次 WarningsNotAsErrors 就绕过去了），
		  因此显式升为错误：公开 API 的新增与删除都必须落在 PublicAPI.*.txt 里被评审到。
		-->
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!--
		  符号单独成包（.snupkg）而不是塞进主包：主包只留使用者运行期真正需要的东西，
		  调试符号按需从 nuget.org 符号服务器下载。这里刻意不再用
		  AllowedOutputExtensionsInPackageBuildOutputFolder 把 .pdb 塞进 lib/（上一代的 1.2.x 正是那么发的，
		  结果是每个使用者的还原目录里都躺着一份用不上的 pdb）。
		-->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
	<ItemGroup>
		<!-- 公开 API 基线：Shipped 是已发布过的形态，Unshipped 是尚未随包发布的形态。 -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<!-- 开发期：让生成器/分析器在本解决方案内可用（不参与编译引用，也不参与打包依赖） -->
		<ProjectReference Include="..\Len.StronglyTypedId.Generators\Len.StronglyTypedId.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

	<!--
	  让主包依赖 Len.StronglyTypedId.Generators。

	  ── 为什么不能声明式解决 ──────────────────────────────────────────────
	  上面那条 ProjectReference 必须同时满足两件事：① 作为 Analyzer 参与本项目的编译；
	  ② 不进编译引用 —— 否则生成器带的 Roslyn 程序集会和 net8.0 的引用程序集撞版本，
	  实测直接报一片 MSB3277（System.Collections.Immutable / System.Reflection.Metadata
	  的 8.0.0.0 与 10.0.0.0 冲突）。同时满足这两点的唯一写法就是 ReferenceOutputAssembly=false，
	  而 NuGet 构建 restore 图时只收 ReferenceOutputAssembly 为空或 true 的项目引用
	  （GetRestoreProjectReferencesTask.Execute），所以它永远进不了 project.assets.json；
	  打包侧的依赖列表又恰恰是从 assets 的 framework.ProjectReferences 循环出来的
	  （PackTaskLogic.InitializeProjectDependencies），因此无论怎么摆弄 MSBuild item
	  都不会自动产生这条依赖。这是 NuGet 当前的机制限制，不是配置没写对 ——
	  别再把这段改回「往 _ProjectReferencesWithVersions 里塞一项」，PackTask 根本不看它。

	  ── 因此只能修补产物，但修补必须「响亮失败」────────────────────────────
	  Pack 内部会重新生成 nuspec，唯一可干预的位置是产物 .nupkg。修补本身不可避免，
	  但绝不能让它在前提不成立时静默跳过 —— 那正是「使用者装包后拿不到生成器、
	  却没有任何报错」的来源。下面每一步都先断言再动手：
	    1. 产物包必须存在；
	    2. nuspec 必须有 <dependencies><group>（XmlPoke 的 Query 依赖它，匹配不到会静默无效）；
	    3. 已存在该依赖则跳过（幂等，将来 NuGet 原生支持后这段不会重复注入）；
	    4. 重压到临时文件成功后才替换原包（中途失败不会留下半个包）；
	    5. 写完后立刻读回，确认依赖真的落进 nuspec。
	  任一步不成立都以 <Error> 中止构建。

	  依赖版本取 $(PackageVersion)，与主包同源同版本。
	  第二道哨兵：test/Len.StronglyTypedId.Packaging.Test 的
	  MainPackage_Should_DependOnGeneratorsPackage_ForEveryTargetFramework 逐 TFM 断言 id 与版本。
	-->
	<Target Name="InjectGeneratorsPackageDependency" AfterTargets="Pack">
		<PropertyGroup>
			<_PkgPath>$([MSBuild]::EnsureTrailingSlash('$(PackageOutputAbsolutePath)'))$(PackageId).$(PackageVersion).nupkg</_PkgPath>
			<_PkgPatchDir>$(BaseIntermediateOutputPath)$(Configuration)\__pkgpatch\</_PkgPatchDir>
			<_PkgRepackedPath>$(BaseIntermediateOutputPath)$(Configuration)\__pkgpatch.repacked.nupkg</_PkgRepackedPath>
			<_PkgDependencyId>Len.StronglyTypedId.Generators</_PkgDependencyId>
		</PropertyGroup>

		<Error Condition="!Exists('$(_PkgPath)')"
		       Text="InjectGeneratorsPackageDependency：找不到待修补的包 '$(_PkgPath)'。这条依赖只能靠修补产物注入，路径对不上就意味着包会缺少生成器依赖。" />

		<RemoveDir Directories="$(_PkgPatchDir)" Condition="Exists('$(_PkgPatchDir)')" />
		<Unzip SourceFiles="$(_PkgPath)" DestinationFolder="$(_PkgPatchDir)" />
		<ItemGroup>
			<_PkgNuspec Include="$(_PkgPatchDir)*.nuspec" />
		</ItemGroup>

		<!-- 断言 1：nuspec 里确实有 <dependencies><group>，否则下面的 XmlPoke 会静默匹配不到 -->
		<XmlPeek XmlInputPath="@(_PkgNuspec)"
		         Query="//*[local-name()='package']/*[local-name()='metadata']/*[local-name()='dependencies']/*[local-name()='group']/@targetFramework">
			<Output TaskParameter="Result" PropertyName="_PkgFirstDependencyGroupTfm" />
		</XmlPeek>
		<Error Condition="'$(_PkgFirstDependencyGroupTfm)' == ''"
		       Text="InjectGeneratorsPackageDependency：nuspec 里没有 &lt;dependencies&gt;&lt;group&gt; 节点，依赖注入会静默失效。请检查 PackageReference 与目标框架配置。" />

		<!-- 断言 2：幂等 —— 已经有这条依赖就不再注入 -->
		<XmlPeek XmlInputPath="@(_PkgNuspec)"
		         Query="//*[local-name()='dependency'][@id='$(_PkgDependencyId)']/@version">
			<Output TaskParameter="Result" PropertyName="_PkgExistingDependencyVersion" />
		</XmlPeek>

		<XmlPoke Condition="'$(_PkgExistingDependencyVersion)' == ''"
		         XmlInputPath="@(_PkgNuspec)"
		         Query="//*[local-name()='package']/*[local-name()='metadata']/*[local-name()='dependencies']/*[local-name()='group']"
		         Value="&lt;dependency id='$(_PkgDependencyId)' version='$(PackageVersion)' /&gt;" />

		<!-- 断言 3：写完立刻读回，确认依赖真的落进 nuspec（XmlPoke 静默无效时在这里炸）。
		     XmlPeek 对多个匹配节点用 ';' 拼接（每个目标框架一组），这里只断言「读到了」，
		     逐 TFM 的版本正确性交给 Packaging.Test 守 —— 在 MSBuild 条件里做字符串拆分
		     既难读又容易踩 MSB4092（属性函数参数里嵌套 $(...) 的解析限制）。 -->
		<XmlPeek Condition="'$(_PkgExistingDependencyVersion)' == ''"
		         XmlInputPath="@(_PkgNuspec)"
		         Query="//*[local-name()='dependency'][@id='$(_PkgDependencyId)']/@version">
			<Output TaskParameter="Result" PropertyName="_PkgInjectedDependencyVersion" />
		</XmlPeek>
		<Error Condition="'$(_PkgExistingDependencyVersion)' == '' and '$(_PkgInjectedDependencyVersion)' == ''"
		       Text="InjectGeneratorsPackageDependency：依赖写入后读回为空，XmlPoke 没有真正改动 nuspec。包已损坏，构建中止。" />

		<!-- 断言 4：先重压到临时文件，成功后再替换原包，避免中途失败留下半个包 -->
		<Delete Files="$(_PkgRepackedPath)" Condition="Exists('$(_PkgRepackedPath)')" />
		<ZipDirectory Condition="'$(_PkgExistingDependencyVersion)' == ''"
		              SourceDirectory="$(_PkgPatchDir)"
		              DestinationFile="$(_PkgRepackedPath)"
		              Overwrite="true" />
		<!-- MSBuild 的 Move 任务没有 Overwrite / DeleteDestinationFileIfNecessary 参数，
		     目标存在时会直接失败，所以先删再移。ZipDirectory 已经在临时路径上成功产出，
		     这里删掉的只是「待替换的旧包」，窗口极短。 -->
		<Delete Condition="'$(_PkgExistingDependencyVersion)' == ''" Files="$(_PkgPath)" />
		<Move Condition="'$(_PkgExistingDependencyVersion)' == ''"
		      SourceFiles="$(_PkgRepackedPath)"
		      DestinationFiles="$(_PkgPath)" />

		<RemoveDir Directories="$(_PkgPatchDir)" />
	</Target>
</Project>
