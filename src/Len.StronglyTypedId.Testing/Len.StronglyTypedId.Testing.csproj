<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\common.props" />
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!--
		  测试辅助包，刻意不声明 IsAotCompatible：造值要靠反射把「Id 类型 + 基元类型」组合成
		  泛型方法（MakeGenericMethod），这在 Native AOT 下必然触发 IL3050。测试代码从不做 AOT 发布，
		  为它背上一堆 RequiresDynamicCode 标注只会让 API 面变脏。
		-->
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!--
		  包说明与主包分开：PACKAGE.md 讲的是生成器与运行时能力，直接复用到测试辅助包会让
		  NuGet 页面误导使用者。common.props 里那条 None 是按主包写的，这里先移除再换成自己的。
		-->
		<PackageReadmeFile>TESTING.md</PackageReadmeFile>
		<Description>Test-time helpers for Len.StronglyTypedId: generate arbitrary but realistic id values for any strongly typed id, with reproducible seeds and validator-aware retries.</Description>
		<PackageTags>len;id;strongly-typed;testing;test-data;fixture;DDD</PackageTags>
		<!-- 本包在 1.3.0-preview.5 基线里不存在，退出跨版本比对（包内一致性校验保留）。 -->
		<StronglyTypedIdPackageValidationBaseline></StronglyTypedIdPackageValidationBaseline>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Len.StronglyTypedId\Len.StronglyTypedId.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="..\..\PACKAGE.md" />
		<None Include="..\..\TESTING.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>
</Project>
