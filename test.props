<Project>
	<PropertyGroup>
		<RootNamespace />

		<IsPackable>false</IsPackable>

		<!--
		  xunit.v3 的 MTP runner 要求测试工程本身是可执行文件（每个 TFM 一个入口 exe）。该属性原先由
		  Microsoft.NET.Test.Sdk 隐式带入，移除该包后必须显式声明，否则 xunit.v3.core.mtp-v2.targets 直接报
		  「must be executable」。
		-->
		<OutputType>Exe</OutputType>

		<!--
		  语言版本与目标框架无关：net8.0 默认只给 C# 12，而本仓库的测试代码用到了更高版本的纯编译器特性
		  （如 nameof 里的未绑定泛型类型，C# 14）。这些特性不需要运行时支持，net8.0 上同样可用，故显式
		  钉到 latest，避免同一份源码在两个 TFM 腿下因语言版本不同而编译结果不一致。
		-->
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!--
	  .NET 10 SDK 起 Microsoft.Testing.Platform 不再支持 VSTest target：工程里只要还留着
	  Microsoft.NET.Test.Sdk / xunit.runner.visualstudio，`dotnet test` 就会退回 VSTest 路径并报错
	  （aka.ms/dotnet-test-mtp-error），表现为「一条测试都没跑」。故只保留 xunit.v3 —— 它自带 MTP in-proc
	  runner，与 global.json 的 "test.runner": "Microsoft.Testing.Platform" 构成唯一受支持的组合。
	-->
	<ItemGroup>
		<PackageReference Include="xunit.v3" />
	</ItemGroup>
</Project>
