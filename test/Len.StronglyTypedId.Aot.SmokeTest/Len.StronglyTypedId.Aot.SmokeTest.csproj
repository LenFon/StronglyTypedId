<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!--
		  本工程是「Native AOT 端到端冒烟」：README / PACKAGE.md 宣称本库可在 AOT 与裁剪环境下工作，这里用真实的
		  PublishAot 产物把核心路径跑一遍（CI 的 aot job）。PublishAot 会隐式打开 AOT / trim 分析器，故本工程代码
		  必须自身零警告 —— 分析器通过 + 运行时通过才算「AOT 可用」，为此刻意不碰反射式序列化，直接调用生成器
		  产出的 SystemTextJsonConverter。
		-->
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!-- 让裁剪 / AOT 警告逐条列出，而不是折叠成一条 IL2104 -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<ItemGroup>
		<!--
		  二进制序列化集成包：使 MessagePackCodeGenerator / MongoDbCodeGenerator 在本工程编译里被门控触发，
		  生成 AddStronglyTypedIds / RegisterBsonSerializers 与各自的格式化器 / 序列化器，从而在
		  Native AOT 下实证这些产物（含本次补的枚举基元已定义性校验分支）零反射、可运行。
		-->
		<PackageReference Include="MessagePack" />
		<PackageReference Include="MongoDB.Bson" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Generators\Len.StronglyTypedId.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId\Len.StronglyTypedId.csproj" />
	</ItemGroup>

</Project>
