<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\test.props" />
	<PropertyGroup>
		<!-- 测试多目标：net8.0 / net10.0 各跑一遍，覆盖运行时库两个目标框架下的生成与诊断行为。 -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<!-- 显式钉定 Roslyn 版本，与生成器/CodeFix 程序集保持一致（5.9.0），
		     消除因 SourceGenerators.Testing 传递依赖较低 Microsoft.CodeAnalysis 版本引发的 CS1705 冲突。 -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- 生成器快照测试需引用 EF Core 与 Swashbuckle，才能使 EfCoreCodeGenerator / SwaggerCodeGenerator 被触发。 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
		<!-- ASP.NET Core 框架引用：使 AspNetCoreMvcCodeGenerator 在「真实引用 MVC」的消费者画像下可被触发，
		     并为 MVC / 路由集成提供可编译的命名空间和类型（MvcOptions / IModelBinder / IRouteConstraint 等）。 -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Generators\Len.StronglyTypedId.Generators.csproj" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId\Len.StronglyTypedId.csproj" />
		<ProjectReference Include="..\Len.StronglyTypedId.TestBase\Len.StronglyTypedId.TestBase.csproj" />
		<!-- README 表格由 DocGen 从生成器内部数据渲染，测试直接调用同一套渲染器断言 README 未过期。 -->
		<ProjectReference Include="..\..\tools\Len.StronglyTypedId.DocGen\Len.StronglyTypedId.DocGen.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  并发上限：本工程绝大多数用例都在跑 Roslyn 合成编译，属于内存带宽密集型。
		  实测（24 核）并发 4/6/8/10/12/24 路的墙钟分别为 16.3/14.6/14.1/15.0/15.0/16.1 秒 ——
		  8 路最优，再往上 GC 与元数据导入争抢会把单测成本抬高数倍（串行总耗时从 39s 膨胀到 130s）。
		-->
		<None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
	  Analyzer / CodeFix 用例只在 net10.0 腿跑。
	  Verify.ApplyDefaults 把引用程序集固定成 net8.0（Microsoft.NETCore.App.Ref 8.0.0），被测分析器与
	  CodeFix 提供器本身都是 netstandard2.0 单一产物，所以这两个目录下的用例在两个宿主 TFM 下走的是
	  完全相同的编译与诊断路径 —— 双跑等于把同一份工作做两遍，约占本工程一半墙钟。
	  若将来分析器引入 #if NET10_0_OR_GREATER 之类与宿主相关的分支，必须撤销这条排除。
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<Compile Remove="Len\StronglyTypedId\Analyzers\**\*.cs" />
		<Compile Remove="Len\StronglyTypedId\CodeFixes\**\*.cs" />
	</ItemGroup>

</Project>
