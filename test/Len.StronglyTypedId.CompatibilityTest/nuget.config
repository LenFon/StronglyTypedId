<?xml version="1.0" encoding="utf-8"?>
<!--
  只指向 CI 刚打包出来的本地源（仓库根的 artifacts/packages）。不写 nuget.org：
  探针要验证的是「这一份产物」，一旦回落到线上包，测的就不是本次构建了。

  相对路径以本文件所在目录为基准。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
  </packageSources>
</configuration>
