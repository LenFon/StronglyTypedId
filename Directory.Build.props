<Project>

	<!--
	  IDE 风格分析器（IDE0xxx）默认只在 IDE 里跑，`dotnet build` 不报它们，.editorconfig 里的 `:warning`
	  规则在构建里形同虚设。放在这里而不是 common/test/bench.props：只有 Directory.Build.props 能被
	  MSBuild 自动导入、覆盖全部工程。
	-->
	<PropertyGroup>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!--
	  NuGet Audit：还原阶段就报出依赖里的已知漏洞。显式声明是为了把取值钉在仓库里 —— 默认值漂移过
	  （NuGetAuditMode 在 .NET 9 由 direct 改成 all）。

	  Mode 取 direct：现存漏洞都在 test / samples / bench 的传递依赖里，不进任何发布包，报成警告只会
	  淹没真正的信号。发布物的完整依赖链由 common.props 的 all 单独把关。
	-->
	<PropertyGroup>
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditLevel>low</NuGetAuditLevel>
		<NuGetAuditMode>direct</NuGetAuditMode>
	</PropertyGroup>

</Project>
