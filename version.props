<Project>
	<PropertyGroup>
		<!--
		  本地/开发用的占位版本号：发布流程会先跑 dotnet TagToVersion 按 git tag 覆写本文件，再打包。
		  取值必须 ≥ 最近一次发布（当前为 1.3.0-preview.5），否则本地 dotnet build -c Release 会因为
		  GeneratePackageOnBuild=True 触发打包，并被包校验的「程序集版本应等于或高于基线」规则（CP0003）拦下。
		-->
		<Version>1.3.0</Version>
	</PropertyGroup>
</Project>
