<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!--
		     OpenAPI 集成要求 Microsoft.AspNetCore.OpenApi ≥ 9.0.0，而 9.x 起只面向 net9.0+，故本示例以 net10.0 为目标。
		-->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- 中心版本 8.0.32 服务于 net8.0 的示例，这里单独抬到 10.x。 -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" VersionOverride="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Len.StronglyTypedId.Domain\Len.StronglyTypedId.Domain.csproj" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Generators\Len.StronglyTypedId.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
