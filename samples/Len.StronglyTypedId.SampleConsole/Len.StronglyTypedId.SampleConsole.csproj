<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net10.0 用来演示 Guid 基元的 IUtf8SpanParsable（.NET 10 起才有）；
		     net8.0 则验证同一份代码在最低支持版本上的行为。 -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="Bogus" />
		<!-- 配置绑定演示：binder 走 TypeDescriptor，只有开了 TypeConverter 的 Id 才能被绑定。 -->
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Newtonsoft.Json" />
		<!-- 第三方自定义基元的示例：ULID 满足自定义基元契约，本库零改动即可用。 -->
		<PackageReference Include="Ulid" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Generators\Len.StronglyTypedId.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId\Len.StronglyTypedId.csproj" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Testing\Len.StronglyTypedId.Testing.csproj" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Testing.AutoFixture\Len.StronglyTypedId.Testing.AutoFixture.csproj" />
		<ProjectReference Include="..\..\src\Len.StronglyTypedId.Testing.Bogus\Len.StronglyTypedId.Testing.Bogus.csproj" />
	</ItemGroup>

</Project>
