<Project>
	<Import Project="version.props" />
	<PropertyGroup>
		<RootNamespace />
		<!-- 发布物查全链：src 下五个工程产出的包会被别人引用，其传递依赖也是使用者的依赖。 -->
		<NuGetAuditMode>all</NuGetAuditMode>

		<IsPackable>true</IsPackable>
		<Authors>lenfon</Authors>
		<Description>A source generator, analyzer, and code fix provider that turns a one-line record declaration into a fully featured strongly typed id, with built-in System.Text.Json, Newtonsoft.Json, Entity Framework Core, Dapper, Swashbuckle, and ASP.NET Core OpenAPI integrations.</Description>
		<PackageTags>len;id;strongly-typed;primitive;value;DDD</PackageTags>
		<PackageProjectUrl>https://github.com/lenfon/StronglyTypedId</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/lenfon/StronglyTypedId</RepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
		<!--
		  包图标：路径是「包内路径」而非磁盘路径 —— 真正的文件由下面那条 None 以 PackagePath="\" 放进包根，
		  两者必须同名，否则 pack 报 NU5046。用 $(MSBuildThisFileDirectory) 而非 ..\..\：本文件被深度不一的
		  工程导入，只有属性函数给出的绝对路径与导入方无关。
		-->
		<PackageIcon>icon.png</PackageIcon>
		<!--
		  指向 CHANGELOG 而不是内联文本：内联要每次发版手工同步，而 CHANGELOG 已由 DocGen 的 verify-changelog
		  门禁守着（tag 与两份 CHANGELOG 的小节必须对得上），指向它等于复用了那道门禁。
		-->
		<PackageReleaseNotes>See https://github.com/lenfon/StronglyTypedId/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<!--
		  生成器产物这类未纳入版本控制的源文件也嵌入 pdb，否则 F11 只能停在「找不到源代码」。符号包只在
		  Len.StronglyTypedId 项目里开启：分析器包除 analyzers/dotnet/cs 下的 dll 外无打包内容，开符号包会撞
		  NU5017（既无依赖项也无内容的包）。
		-->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!--
		  打包时做 API 兼容性校验：删成员 / 改签名 / 去目标框架 / 降程序集版本都会在 pack 阶段报错。
		  基线只在「当前版本 ≥ 基线」时挂上 —— version.props 是本地占位号，低于基线，此时退化为包内
		  一致性校验；发布流水线按 tag 覆写版本号后自动恢复跨版本比对。
		  有意为之的破坏性变更用 `dotnet build -c Release -p:Version=<高于基线>
		  -p:ApiCompatGenerateSuppressionFile=true` 重建 CompatibilitySuppressions.xml 并入库，
		  禁止用 NoWarn 压制。
		-->
		<EnablePackageValidation>true</EnablePackageValidation>
		<StronglyTypedIdPackageValidationBaseline>1.3.0-preview.5</StronglyTypedIdPackageValidationBaseline>
		<!--
		  新包（如 Testing）在基线版本里并不存在，挂基线只会让 pack 去 nuget.org 找一个从未发布过的包而失败。
		  这类项目在自己的 csproj 里把 StronglyTypedIdPackageValidationBaseline 置空即可退出跨版本比对，
		  包内一致性校验仍然生效。
		-->
		<PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == '' and '$(StronglyTypedIdPackageValidationBaseline)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(Version)', '$(StronglyTypedIdPackageValidationBaseline)'))">$(StronglyTypedIdPackageValidationBaseline)</PackageValidationBaselineVersion>
		<!--
		  没挂基线时放过「不必要的抑制」告警（CP0021，含 [Baseline] 变体）：SDK 只要发现项目目录下有
		  CompatibilitySuppressions.xml 就会自动加载它（Microsoft.NET.ApiCompat.Common.targets），与是否挂基线
		  无关；本地占位版本号不挂基线，抑制条目没有对应的基线可比，于是每条都被判成「不必要」而让
		  `dotnet pack` 直接失败。挂上基线后此属性为空，条目真失效了仍会报 CP0021，不会被掩盖。
		-->
		<ApiCompatPermitUnnecessarySuppressions Condition="'$(PackageValidationBaselineVersion)' == ''">true</ApiCompatPermitUnnecessarySuppressions>
		<!--
		  程序集版本号默认 1.0.0.0（显式声明以防被 IDE 工具改动）。发布 / CI 的 pack 步骤用
		  -p:AssemblyVersion=<major.minor.0.0> 透传与包版本号主号一致的值（见 build-and-test.yml pack job），
		  使 CP0003 通过；Condition 保证外部传入值优先。
		-->
		<AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">1.0.0.0</FileVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<!-- 只在 Release 下隐式打包（Debug 保持纯构建）。 -->
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>
	<!--
	  CI 上开启确定性构建：pdb / 程序集里的路径改写为源码管理路径（/_/…），同一份源码在任何机器上产出
	  逐字节一致的程序集，符号服务器也能据此定位 GitHub 上的源文件。只在 CI 启用是因为它要求工作树可追溯
	  到远端仓库，本地未提交的改动会被它挡住。
	-->
	<PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\PACKAGE.md" Pack="true" PackagePath="\"/>
		<!-- 包图标：与上面 PackageIcon 声明的包内路径同名。Visible=false 免得在 IDE 里多出一个重复条目。 -->
		<None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false"/>
	</ItemGroup>
</Project>
